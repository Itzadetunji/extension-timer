{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["DOM", "ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["chrome"],
		"paths": {
      "@/*": ["./src/*"]
    }
	},
	"include": ["src"]
}
